{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin-panel/index.html",
      "permanent": false
    },
    {
      "source": "/admin/login",
      "destination": "/admin-panel/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/journal/:slug",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/articles/:slug"
    },
    {
      "source": "/journal-images/:id",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/post-images/:id"
    },
    {
      "source": "/journal-sitemap.xml",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/admin-panel/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
