Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Match the original request only so the homepage PHP rendering cannot loop.
  RewriteCond %{THE_REQUEST} \s/+index\.html[/?\s] [NC]
  RewriteRule ^index\.html/?$ / [R=301,L,NC]
  # One editorial hub; existing guide and experiment URLs remain stable.
  RewriteRule ^journal/?$ /blog/index.html [R=301,L,NC]
  # One permanent HTTPS hostname for the review domain. Preserve path/query.
  # Other hosts remain available for local development and the Vercel preview.
  RewriteCond %{HTTP_HOST} ^www\.nevco\.online(?::\d+)?$ [NC]
  RewriteRule ^ https://nevco.online%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^nevco\.online(?::\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://nevco.online%{REQUEST_URI} [R=301,L,NE]
  # Retired unillustrated guides
  RewriteRule ^blog/temporary-email-vs-aliases\.html/?$ /journal/temporary-email-for-authorized-testing-and-permitted-messages [R=301,L,NC]
  RewriteRule ^blog/merge-pdfs-locally\.html/?$ /journal/simple-pdf-workflow-without-software [R=301,L,NC]
  RewriteRule ^blog/images-to-clear-pdfs\.html/?$ /journal/simple-pdf-workflow-without-software [R=301,L,NC]
  RewriteRule ^blog/background-removal-and-transparency\.html/?$ /journal/best-practices-for-background-removal-when-working-with-design [R=301,L,NC]
  RewriteRule ^blog/format-and-check-json\.html/?$ /journal/small-tools-that-save-developers-time [R=301,L,NC]
  RewriteRule ^blog/jwt-decoding\.html/?$ /journal/small-tools-that-save-developers-time [R=301,L,NC]
  RewriteRule ^blog/base64-text-encoding\.html/?$ /journal/small-tools-that-save-developers-time [R=301,L,NC]
  RewriteRule ^blog/sha256-text-checks\.html/?$ /journal/small-tools-that-save-developers-time [R=301,L,NC]
  RewriteRule ^blog/qr-codes-for-print\.html/?$ - [G,L,NC]
  RewriteRule ^blog/strong-passwords\.html/?$ - [G,L,NC]
  RewriteRule ^blog/word-and-character-counts\.html/?$ - [G,L,NC]
  RewriteRule ^blog/url-encoding-components\.html/?$ /journal/small-tools-that-save-developers-time [R=301,L,NC]
  # End Retired unillustrated guides
  # Retired game entry points now lead to the current homepage.
  RewriteRule ^snowy-peaks-solitaire(?:/(?:index\.(?:html?|php))?)?/?$ / [R=301,L,NC]
  # An HTML file is not a directory; normalize old trailing-slash links.
  RewriteRule ^([a-z0-9/-]+\.html)/+$ /$1 [R=301,L,NC]
  # Published article listings are visible to readers and crawlers without JS.
  RewriteRule ^blog(?:/index\.html|/?)$ blog-index.php [L,QSA,NC]
  # Keep published articles and their private-storage covers on this frontend's
  # domain. The PHP handlers forward the detected domain to the API so generated
  # canonical URLs, assets and navigation never point at another frontend.
  RewriteRule ^journal/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ journal.php?slug=$1 [L,QSA,NC]
  RewriteRule ^journal-images/([a-f0-9-]{36})/?$ journal-image.php?id=$1 [L,QSA,NC]
  RewriteRule ^sitemap\.xml$ site-metadata.php?document=sitemap [L,QSA]
  RewriteRule ^sitemap-index\.xml$ site-metadata.php?document=index [L,QSA]
  RewriteRule ^robots\.txt$ site-metadata.php?document=robots [L,QSA]
  RewriteRule ^journal-sitemap\.xml$ journal-sitemap.php [L,QSA]
  RewriteRule ^admin/login/?$ /admin-panel/login.html [R=302,L]
  RewriteRule ^admin/?$ /admin-panel/index.html [R=302,L]
  # Render static pages with this request's origin in canonical and Open Graph
  # URLs. The stored Vercel URLs remain valid when the same files run on Vercel.
  RewriteRule ^$ static-page.php?path=index.html [L,QSA]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.+\.html)$ static-page.php?path=$1 [L,QSA,NC]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://epxzxcqsonxscyvbopqt.supabase.co; font-src 'self'; connect-src 'self' https://anvil-tools-backend.vercel.app https://epxzxcqsonxscyvbopqt.supabase.co wss://epxzxcqsonxscyvbopqt.supabase.co https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'"
  # Dynamic JS is required only by the image-processing bundle.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://epxzxcqsonxscyvbopqt.supabase.co; font-src 'self'; connect-src 'self' blob: https://anvil-tools-backend.vercel.app https://epxzxcqsonxscyvbopqt.supabase.co wss://epxzxcqsonxscyvbopqt.supabase.co https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'" "expr=%{THE_REQUEST} =~ m#\s/+tools/background-remover\.html/?[?\s]#"
  # HTTPS only, scoped to this host; do not assert unverified subdomain support.
  Header always set Strict-Transport-Security "max-age=604800" "expr=%{HTTPS} == 'on'"
  Header always unset X-Powered-By
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(?:pdf-lib-1\.17\.1|qrcode-1\.0\.0)\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/json .json
  AddType text/csv .csv
  AddType text/plain .txt
  AddType application/pdf .pdf
  AddType image/webp .webp
</IfModule>
