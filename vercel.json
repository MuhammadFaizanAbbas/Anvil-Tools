{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin-panel/index.html",
      "permanent": false
    },
    {
      "source": "/admin/login",
      "destination": "/admin-panel/login.html",
      "permanent": false
    },
    {
      "source": "/blog/posts/:slug",
      "destination": "/blog/index.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/blog"
    },
    {
      "source": "/blog/",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/blog"
    },
    {
      "source": "/blog/index.html",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/blog"
    },
    {
      "source": "/journal/:slug",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/articles/:slug"
    },
    {
      "source": "/journal-images/:id",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/post-images/:id"
    },
    {
      "source": "/journal-sitemap.xml",
      "destination": "https://anvil-tools-backend.vercel.app/api/public/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/assets/vendor/background-removal/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
