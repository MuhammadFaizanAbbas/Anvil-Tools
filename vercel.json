{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "^/journal/?$",
      "status": 308,
      "headers": {
        "Location": "/blog/index.html"
      }
    },
    {
      "src": "^/index\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.nevco.online"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://nevco.online/$1"
      }
    },
    {
      "src": "^/blog/temporary-email-vs-aliases\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/temporary-email-for-authorized-testing-and-permitted-messages"
      }
    },
    {
      "src": "^/blog/merge-pdfs-locally\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/simple-pdf-workflow-without-software"
      }
    },
    {
      "src": "^/blog/images-to-clear-pdfs\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/simple-pdf-workflow-without-software"
      }
    },
    {
      "src": "^/blog/background-removal-and-transparency\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/best-practices-for-background-removal-when-working-with-design"
      }
    },
    {
      "src": "^/blog/format-and-check-json\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/small-tools-that-save-developers-time"
      }
    },
    {
      "src": "^/blog/jwt-decoding\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/small-tools-that-save-developers-time"
      }
    },
    {
      "src": "^/blog/base64-text-encoding\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/small-tools-that-save-developers-time"
      }
    },
    {
      "src": "^/blog/sha256-text-checks\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/small-tools-that-save-developers-time"
      }
    },
    {
      "src": "^/blog/qr-codes-for-print\\.html/?$",
      "dest": "/404.html",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "^/blog/strong-passwords\\.html/?$",
      "dest": "/404.html",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "^/blog/word-and-character-counts\\.html/?$",
      "dest": "/404.html",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "^/blog/url-encoding-components\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/journal/small-tools-that-save-developers-time"
      }
    },
    {
      "src": "^/snowy-peaks-solitaire(?:/(?:index\\.(?:html?|php))?)?/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/([a-zA-Z0-9/-]+\\.html)/+$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://epxzxcqsonxscyvbopqt.supabase.co; font-src 'self'; connect-src 'self' https://anvil-tools-backend.vercel.app https://epxzxcqsonxscyvbopqt.supabase.co wss://epxzxcqsonxscyvbopqt.supabase.co https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=604800"
      },
      "continue": true
    },
    {
      "src": "^/tools/background-remover\\.html/?$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://epxzxcqsonxscyvbopqt.supabase.co; font-src 'self'; connect-src 'self' blob: https://anvil-tools-backend.vercel.app https://epxzxcqsonxscyvbopqt.supabase.co wss://epxzxcqsonxscyvbopqt.supabase.co https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "^/assets/vendor/tool-libraries/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/assets/css/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/admin/?$",
      "status": 307,
      "headers": {
        "Location": "/admin-panel/index.html"
      }
    },
    {
      "src": "^/admin/login/?$",
      "status": 307,
      "headers": {
        "Location": "/admin-panel/login.html"
      }
    },
    {
      "src": "^/blog/posts/[^/]+/?$",
      "status": 308,
      "headers": {
        "Location": "/blog/index.html"
      }
    },
    {
      "src": "^/admin-panel/(.*)$",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/assets/js/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/assets/vendor/background-removal/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/blog(?:/index\\.html|/?)$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/blog"
    },
    {
      "src": "^/journal/([^/]+)/?$",
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "https://anvil-tools-backend.vercel.app/api/public/articles/$1"
    },
    {
      "src": "^/journal-images/([^/]+)/?$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/post-images/$1"
    },
    {
      "src": "^/journal-sitemap\\.xml$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/sitemap.xml"
    },
    {
      "handle": "filesystem"
    }
  ]
}
