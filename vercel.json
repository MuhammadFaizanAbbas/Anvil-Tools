{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "^/admin/?$",
      "status": 307,
      "headers": {
        "Location": "/admin-panel/index.html"
      }
    },
    {
      "src": "^/admin/login/?$",
      "status": 307,
      "headers": {
        "Location": "/admin-panel/login.html"
      }
    },
    {
      "src": "^/blog/posts/[^/]+/?$",
      "status": 308,
      "headers": {
        "Location": "/blog/index.html"
      }
    },
    {
      "src": "^/admin-panel/(.*)$",
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/assets/js/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/assets/vendor/background-removal/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/blog(?:/index\\.html|/?)$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/blog"
    },
    {
      "src": "^/journal/([^/]+)/?$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/articles/$1"
    },
    {
      "src": "^/journal-images/([^/]+)/?$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/post-images/$1"
    },
    {
      "src": "^/journal-sitemap\\.xml$",
      "dest": "https://anvil-tools-backend.vercel.app/api/public/sitemap.xml"
    },
    {
      "handle": "filesystem"
    }
  ]
}
